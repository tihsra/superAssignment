# Get a free key at https://aistudio.google.com/apikey — no credit card, no GCP project required.
# IMPORTANT: do not enable billing on a GCP project for this key. Enabling billing can silently
# remove the free tier. Use the plain AI Studio free-tier path.
GEMINI_API_KEY=

# Models. gemini-2.0-flash and text-embedding-004 (the guide's original recommendations)
# were both retired by Google after this project was first built — see the README's
# "A real finding" section. These are the current (Sept 2026) free-tier replacements.
# If you hit a 404 "model no longer available" error, check
# https://ai.google.dev/gemini-api/docs/models for the current model ID and update these.
GEMINI_EXTRACTION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Server
PORT=3001

# SQLite file location
DB_PATH=./data/facts.db

# Dev/debug knobs (see fact-knowledge-layer-additional-context.md §6)
# Cache LLM responses on disk keyed by (page content hash, prompt version) so repeated
# debugging runs against the same document don't re-spend free-tier quota.
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=./data/llm-cache

# Process only the first N pages of a document for fast iteration. Unset = full document.
DEV_MAX_PAGES=5

# Candidate-matching similarity threshold (cosine). Start ~0.75, tune by inspection.
MATCH_SIMILARITY_THRESHOLD=0.75

# Metric-canonicalization clustering threshold. Kept tight (high) on purpose — see
# fact-knowledge-layer-additional-context.md §3: a wrong merge is worse than no merge.
CANONICAL_SIMILARITY_THRESHOLD=0.90
